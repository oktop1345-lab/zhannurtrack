rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Трекер: читать могут все, менять только владелец.
    match /tracker/{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email in ["ПОЧТА_1@gmail.com", "ПОЧТА_2@gmail.com"];
    }
    // Всё остальное закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
